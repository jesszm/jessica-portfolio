{
  "$schema": "https://www.designtokens.org/schema/2025.10",
  "$description": "JM Portfolio design tokens · W3C DTCG format · v1.0.0. Tiers: primitive → semantic → component.",
  "primitive": {
    "color": {
      "olive": {
        "50":  { "$type": "color", "$value": "#F4F5EE" },
        "100": { "$type": "color", "$value": "#E6E9D8" },
        "200": { "$type": "color", "$value": "#CDD3B3" },
        "300": { "$type": "color", "$value": "#ADB786" },
        "400": { "$type": "color", "$value": "#8C9A5E" },
        "500": { "$type": "color", "$value": "#6B7A3F" },
        "600": { "$type": "color", "$value": "#4B5320", "$description": "Military green. Brand anchor." },
        "700": { "$type": "color", "$value": "#3D4419" },
        "800": { "$type": "color", "$value": "#2F3514" },
        "900": { "$type": "color", "$value": "#22270F" },
        "950": { "$type": "color", "$value": "#141708" }
      },
      "bone": {
        "0":   { "$type": "color", "$value": "#FFFFFF" },
        "50":  { "$type": "color", "$value": "#FAFAF6" },
        "100": { "$type": "color", "$value": "#F2F2EB" },
        "200": { "$type": "color", "$value": "#E4E4DA" },
        "300": { "$type": "color", "$value": "#CFCFC2" },
        "400": { "$type": "color", "$value": "#A8A899" },
        "450": { "$type": "color", "$value": "#8F8F82", "$description": "Subtle text on dark (5.7:1)." },
        "500": { "$type": "color", "$value": "#7C7C6E", "$description": "Decorative only — 4.0:1 on light fails AA for text." },
        "550": { "$type": "color", "$value": "#6B6B5E", "$description": "Subtle text on light (5.2:1)." },
        "600": { "$type": "color", "$value": "#5A5A4F" },
        "700": { "$type": "color", "$value": "#3E3E36" },
        "800": { "$type": "color", "$value": "#26261F" },
        "900": { "$type": "color", "$value": "#181812" },
        "950": { "$type": "color", "$value": "#121410" }
      },
      "sand": {
        "300": { "$type": "color", "$value": "#E8DFBF" },
        "400": { "$type": "color", "$value": "#D4C48F" },
        "500": { "$type": "color", "$value": "#B8A263" },
        "600": { "$type": "color", "$value": "#8F7C44" },
        "700": { "$type": "color", "$value": "#6E5F32", "$description": "Sand as text on light (6.0:1)." }
      },
      "functional": {
        "redline": { "$type": "color", "$value": "#CF3327", "$description": "Measurements and redlines only (light). Dark uses redline-300 #F07A6F." },
        "redline-300": { "$type": "color", "$value": "#F07A6F" },
        "proto-700": { "$type": "color", "$value": "#1E5FC2", "$description": "Proto colour when used as text on light (5.8:1)." },
        "proto-300": { "$type": "color", "$value": "#6FA8FF", "$description": "Proto colour on dark surfaces." },
        "success-700": { "$type": "color", "$value": "#2E7A3C" },
        "success-300": { "$type": "color", "$value": "#7CC98A" },
        "warning-700": { "$type": "color", "$value": "#8A5E0B" },
        "warning-300": { "$type": "color", "$value": "#E0A63A" },
        "danger-300":  { "$type": "color", "$value": "#F07A6F" },
        "proto":   { "$type": "color", "$value": "#2F80ED", "$description": "Prototype connections, hotspots, focus ring." },
        "success": { "$type": "color", "$value": "#3F8F4E" },
        "warning": { "$type": "color", "$value": "#C98A1B" },
        "danger":  { "$type": "color", "$value": "#C53A2E" }
      }
    },
    "font": {
      "family": {
        "display": { "$type": "fontFamily", "$value": ["Instrument Serif", "Georgia", "serif"] },
        "sans":    { "$type": "fontFamily", "$value": ["Inter", "system-ui", "sans-serif"] },
        "mono":    { "$type": "fontFamily", "$value": ["JetBrains Mono", "ui-monospace", "monospace"] }
      },
      "size": {
        "12": { "$type": "dimension", "$value": { "value": 0.75, "unit": "rem" } },
        "13": { "$type": "dimension", "$value": { "value": 0.8125, "unit": "rem" } },
        "14": { "$type": "dimension", "$value": { "value": 0.875, "unit": "rem" } },
        "16": { "$type": "dimension", "$value": { "value": 1, "unit": "rem" } },
        "18": { "$type": "dimension", "$value": { "value": 1.125, "unit": "rem" } },
        "20": { "$type": "dimension", "$value": { "value": 1.25, "unit": "rem" } },
        "24": { "$type": "dimension", "$value": { "value": 1.5, "unit": "rem" } },
        "32": { "$type": "dimension", "$value": { "value": 2, "unit": "rem" } },
        "40": { "$type": "dimension", "$value": { "value": 2.5, "unit": "rem" } },
        "56": { "$type": "dimension", "$value": { "value": 3.5, "unit": "rem" } },
        "72": { "$type": "dimension", "$value": { "value": 4.5, "unit": "rem" } },
        "96": { "$type": "dimension", "$value": { "value": 6, "unit": "rem" } }
      },
      "lineHeight": {
        "tight":   { "$type": "number", "$value": 1.05 },
        "snug":    { "$type": "number", "$value": 1.2 },
        "normal":  { "$type": "number", "$value": 1.5 },
        "relaxed": { "$type": "number", "$value": 1.65 }
      }
    },
    "space": {
      "1":  { "$type": "dimension", "$value": { "value": 4,   "unit": "px" } },
      "2":  { "$type": "dimension", "$value": { "value": 8,   "unit": "px" } },
      "3":  { "$type": "dimension", "$value": { "value": 12,  "unit": "px" } },
      "4":  { "$type": "dimension", "$value": { "value": 16,  "unit": "px" } },
      "5":  { "$type": "dimension", "$value": { "value": 24,  "unit": "px" } },
      "6":  { "$type": "dimension", "$value": { "value": 32,  "unit": "px" } },
      "7":  { "$type": "dimension", "$value": { "value": 48,  "unit": "px" } },
      "8":  { "$type": "dimension", "$value": { "value": 64,  "unit": "px" } },
      "9":  { "$type": "dimension", "$value": { "value": 96,  "unit": "px" } },
      "10": { "$type": "dimension", "$value": { "value": 128, "unit": "px" } }
    },
    "radius": {
      "0":    { "$type": "dimension", "$value": { "value": 0,   "unit": "px" } },
      "1":    { "$type": "dimension", "$value": { "value": 2,   "unit": "px" } },
      "2":    { "$type": "dimension", "$value": { "value": 4,   "unit": "px" } },
      "3":    { "$type": "dimension", "$value": { "value": 8,   "unit": "px" } },
      "full": { "$type": "dimension", "$value": { "value": 999, "unit": "px" } }
    },
    "duration": {
      "1": { "$type": "duration", "$value": { "value": 120,  "unit": "ms" } },
      "2": { "$type": "duration", "$value": { "value": 200,  "unit": "ms" } },
      "3": { "$type": "duration", "$value": { "value": 320,  "unit": "ms" } },
      "4": { "$type": "duration", "$value": { "value": 600,  "unit": "ms" } },
      "5": { "$type": "duration", "$value": { "value": 1200, "unit": "ms" } }
    },
    "easing": {
      "standard":   { "$type": "cubicBezier", "$value": [0.2, 0.7, 0.2, 1] },
      "emphasized": { "$type": "cubicBezier", "$value": [0.05, 0.7, 0.1, 1] },
      "exit":       { "$type": "cubicBezier", "$value": [0.4, 0, 1, 1] }
    }
  },
  "semantic": {
    "color": {
      "bg":            { "$type": "color", "$value": "{primitive.color.bone.50}" },
      "bg-elevated":   { "$type": "color", "$value": "{primitive.color.bone.0}" },
      "bg-sunken":     { "$type": "color", "$value": "{primitive.color.bone.100}" },
      "text":          { "$type": "color", "$value": "{primitive.color.bone.950}" },
      "text-muted":    { "$type": "color", "$value": "{primitive.color.bone.600}" },
      "text-subtle":   { "$type": "color", "$value": "{primitive.color.bone.550}" },
      "proto-text":    { "$type": "color", "$value": "{primitive.color.functional.proto-700}" },
      "text-on-redline": { "$type": "color", "$value": "{primitive.color.bone.0}" },
      "success-text":  { "$type": "color", "$value": "{primitive.color.functional.success-700}" },
      "warning-text":  { "$type": "color", "$value": "{primitive.color.functional.warning-700}" },
      "danger-text":   { "$type": "color", "$value": "{primitive.color.functional.danger}" },
      "accent-text":   { "$type": "color", "$value": "{primitive.color.sand.700}" },
      "text-on-brand": { "$type": "color", "$value": "{primitive.color.bone.0}" },
      "brand":         { "$type": "color", "$value": "{primitive.color.olive.600}" },
      "brand-hover":   { "$type": "color", "$value": "{primitive.color.olive.700}" },
      "brand-active":  { "$type": "color", "$value": "{primitive.color.olive.800}" },
      "brand-subtle":  { "$type": "color", "$value": "{primitive.color.olive.100}" },
      "brand-muted":   { "$type": "color", "$value": "{primitive.color.olive.300}" },
      "accent":        { "$type": "color", "$value": "{primitive.color.sand.500}" },
      "border":        { "$type": "color", "$value": "{primitive.color.bone.300}" },
      "border-strong": { "$type": "color", "$value": "{primitive.color.bone.950}" },
      "focus":         { "$type": "color", "$value": "{primitive.color.functional.proto}" },
      "redline":       { "$type": "color", "$value": "{primitive.color.functional.redline}" },
      "proto":         { "$type": "color", "$value": "{primitive.color.functional.proto}" }
    }
  },
  "component": {
    "button": {
      "height": {
        "sm": { "$type": "dimension", "$value": { "value": 32, "unit": "px" } },
        "md": { "$type": "dimension", "$value": { "value": 44, "unit": "px" } },
        "lg": { "$type": "dimension", "$value": { "value": 52, "unit": "px" } }
      },
      "padding-x": { "$type": "dimension", "$value": "{primitive.space.5}" },
      "radius":    { "$type": "dimension", "$value": "{primitive.radius.1}" },
      "bg-primary": { "$type": "color", "$value": "{semantic.color.brand}" },
      "fg-primary": { "$type": "color", "$value": "{semantic.color.text-on-brand}" }
    },
    "card": {
      "padding": { "$type": "dimension", "$value": "{primitive.space.5}" },
      "radius":  { "$type": "dimension", "$value": "{primitive.radius.2}" },
      "border":  { "$type": "color", "$value": "{semantic.color.border}" }
    },
    "pin": {
      "size": { "$type": "dimension", "$value": { "value": 24, "unit": "px" } },
      "bg":   { "$type": "color", "$value": "{semantic.color.brand}" },
      "fg":   { "$type": "color", "$value": "{semantic.color.text-on-brand}" }
    }
  }
}
